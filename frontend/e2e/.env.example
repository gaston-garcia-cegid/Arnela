# Copiar a `e2e/.env` y rellenar (no subir `.env` al repositorio).
# PowerShell:  Copy-Item e2e/.env.example e2e/.env
# bash:       cp e2e/.env.example e2e/.env

# URL del Next.js que ejecuta Playwright (debe coincidir con playwright.config baseURL)
E2E_BASE_URL=http://127.0.0.1:3000

# URL de la API v1 (misma semántica que NEXT_PUBLIC_API_URL del front)
E2E_API_URL=http://127.0.0.1:8080/api/v1

# Credenciales de un usuario **admin** del entorno (seed / manual)
E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=changeme
