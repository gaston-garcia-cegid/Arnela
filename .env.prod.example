# ===========================================
# Arnela - Production Environment Variables
# ===========================================
# Copy this file to .env.prod and change the values
# Usage: docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod up -d --build

# --- Database ---
DB_USER=arnela_user
DB_PASSWORD=CHANGE_ME_strong_password_here
DB_NAME=arnela_db

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_redis_password_here

# --- JWT ---
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_jwt_secret_here

# --- Frontend ---
# URL that the browser uses to reach the API (must be accessible from client browser)
NEXT_PUBLIC_API_URL=http://192.168.1.100:8101/api/v1
